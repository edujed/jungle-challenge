# infra/.env
# Variáveis de ambiente para o docker-compose.
# O docker compose lê este arquivo automaticamente.

# PostgreSQL
POSTGRES_DB=wagering
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_PORT=5432

# LocalStack / SQS
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
